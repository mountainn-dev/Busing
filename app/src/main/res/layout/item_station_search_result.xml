<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clStationSearchResultItem"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_item_search_result"
    android:padding="@dimen/margin_padding_default"
    android:background="@drawable/bg_rectangle_downside_grey_bordered">

    <TextView
        android:id="@+id/txtStationName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_padding_default"
        android:textSize="@dimen/text_large"
        app:layout_constraintBottom_toTopOf="@id/txtStationMobileNo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="stationName" />

    <TextView
        android:id="@+id/txtStationMobileNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_padding_default"
        android:textSize="@dimen/text_small"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtStationName"
        tools:text="stationMobileNo" />

    <TextView
        android:id="@+id/txtRegionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_padding_default"
        android:textColor="@color/text_sub"
        android:textSize="@dimen/text_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="regionName" />

</androidx.constraintlayout.widget.ConstraintLayout>